#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    int findMaxConsecutiveOnes(vector<int>& nums) {
        int p=0, count=0;
        int n= nums.size();
        for (int i=0;i<n;i++){
            if(nums[i]==1){
                count++;
                if(count>p){
                    p=count;
                }
            }
            if(nums[i]==0){
                count=0;
            }
        }
         return p;
    }
};